NODE_ENV=development
PORT=3000
# Number of reverse-proxy hops in front of the API (0 = direct).
TRUST_PROXY=0
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=app_user
DB_PASSWORD=replace_me
DB_DATABASE=aera_mineral

# Generate each secret separately: openssl rand -base64 48
# The placeholders below are rejected at startup on purpose.
JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_strong_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=aera-mineral-api
JWT_AUDIENCE=aera-mineral-clients

BCRYPT_ROUNDS=12

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Defaults to true outside production.
SWAGGER_ENABLED=true

# Used only by `npm run seed:admin`. Remove after creating the first admin.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password
